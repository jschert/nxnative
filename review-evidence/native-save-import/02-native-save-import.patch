+// ---- ss_read_limited: the folders a former host's backslash names stand for, budgeted and depth-checked like the paths themselves ----
+static void check_legacy_budget(void) {
+    char root[] = "/tmp/dm-save-sync-metadata-legacy-XXXXXX", bundle[PATH_MAX], into[PATH_MAX];
+    if (!mkdtemp(root)) abort();
+    ss_meta m;
+    bb b;
+    int nk = 0;
