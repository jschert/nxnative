+    // a physical leaf named by a former host counts the same, guest name or not
+    snprintf(bundle, sizeof bundle, "%s/plain.dmsync", root);
+    bb_open(&b, bundle, "0100ABC"); bb_entry(&b, 1, "save/\\a\\b\\c\\f", "", 0, "p", 1); bb_close(&b, 0);
+    ss_limits three = {100, 3, 64};
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &three) != 0 && errno == EFBIG && empty_dir(into) == 1, "a physical backslash leaf with no guest name stands for its folders too");
+    TRY(ss_read_limited(bundle, INTO, &m, &wide) == 0 && file_is(into, "save/\\a\\b\\c\\f", "p"), "and reads at max_paths 4, unpacked under its own name");
