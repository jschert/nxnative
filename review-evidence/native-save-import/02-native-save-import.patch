+static int empty_dir(const char *p) {   // 1: nothing in it, 0: something is, -1: it is not there
+    DIR *d = opendir(p); if (!d) return -1;
+    struct dirent *e; int empty = 1;
+    while ((e = readdir(d))) if (strcmp(e->d_name, ".") && strcmp(e->d_name, "..")) { empty = 0; break; }
+    closedir(d); return empty;
+}
+static int file_is(const char *root, const char *rel, const char *data) {   // the file <root>/<rel> exists and holds exactly data
+    char p[PATH_MAX];
+    if (snprintf(p, sizeof p, "%s/%s", root, rel) >= (int)sizeof p) return 0;
+    int fd = open(p, O_RDONLY); if (fd < 0) return 0;
+    char b[256]; ssize_t got = read(fd, b, sizeof b); close(fd);
+    return got == (ssize_t)strlen(data) && !memcmp(b, data, (size_t)got);
+}
+static int dir_is(const char *root, const char *rel) {
+    char p[PATH_MAX]; struct stat st;
+    snprintf(p, sizeof p, "%s/%s", root, rel);
+    return !lstat(p, &st) && S_ISDIR(st.st_mode);
+}
