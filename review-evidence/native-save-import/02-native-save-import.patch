+// File → Import Save… stages a checked archive; the launcher restores it only after the host exits.
+// The player chooses a folder/ZIP root. Raw payload stays opaque except for recognized JKSV metadata; sources are never changed.
+// Host-only ZIP reader: system libarchive (-larchive; dm/third_party/libarchive/README.md). Content streams in 64-KiB chunks.
+#include "save_backup_mac.h"
+#include "save_sync.h"
+#include "../third_party/libarchive/archive.h"
+#include "../third_party/libarchive/archive_entry.h"
+#include <dirent.h>
