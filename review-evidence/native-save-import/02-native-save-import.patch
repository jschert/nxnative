+    errno = 0;
+    TRY(ss_read_limited(bundle, NULL, &m, &deep) != 0 && errno == EFBIG, "the checking pass refuses it on paths alone when depth allows");
+    TRY(ss_read_limited(bundle, INTO, &m, &room) == 0 && file_is(into, "save/.dm-case-1", "x"), "the same name reads at max_paths 3 and max_depth 3: at the bound");
+    TRY(ss_read(bundle, INTO, &m) == 0 && file_is(into, "save/.dm-case-1", "x"), "the trusted reader takes it: the bounds are for bundles from somewhere else");
+
+    // the work budget: a name's folders count with the node itself, once, at its maximum
+    snprintf(bundle, sizeof bundle, "%s/work.dmsync", root);
