+#define CHUNK (1 << 16)
+#define GUEST_NAME "org.d2rmobile.guest-name"   // save_sync.c's spelling of it (hle_fs.c FS_GUEST_NAME): a file's guest name when its host name had to differ
+// Resource bounds for untrusted imports, counted on actual content. Depth also bounds the recursive serializer's stack use.
+// The packed-input allowance includes metadata as well as the 16-GiB payload budget. Tests narrow these limits for small fixtures.
+static uint64_t import_max_bytes = 16ull << 30;
+static uint64_t import_max_archive_bytes = 17ull << 30;
+static uint32_t import_max_entries = 100000;
+#define IMPORT_MAX_DEPTH 64
+
+#define ILOG(...) do { fprintf(stderr, "[dm] save import: " __VA_ARGS__); fputc('\n', stderr); } while (0)
+
+static int rmrf(const char *p) { return removefile(p, NULL, REMOVEFILE_RECURSIVE); }
+static int join(char *out, size_t n, const char *a, const char *b) {   // a/b; a path is never truncated into another name
+    int k = snprintf(out, n, "%s/%s", a, b);
+    if (k < 0 || (size_t)k >= n) { errno = ENAMETOOLONG; return -1; }
+    return 0;
+}
+static int join_rel(char *out, size_t n, const char *dir, const char *name) {   // dir/name, or name alone at the save root
+    int k = *dir ? snprintf(out, n, "%s/%s", dir, name) : snprintf(out, n, "%s", name);
+    if (k < 0 || (size_t)k >= n) { errno = ENAMETOOLONG; return -1; }
+    return 0;
+}
+static int under(const char *a, const char *b) {   // a is b, or inside it
+    size_t n = strlen(b);
+    return !strcmp(b, "/") ? a[0] == '/' : !strncmp(a, b, n) && (!a[n] || a[n] == '/');
+}
+static int ends_with_ci(const char *s, const char *suf) {   // the player's spelling of a name, whatever its case
+    size_t n = strlen(s), m = strlen(suf);
+    return n >= m && !strcasecmp(s + n - m, suf);
+}
+static int write_all(int fd, const void *b, size_t n) {
+    for (const char *p = b; n; ) {
+        ssize_t k = write(fd, p, n);
+        if (k < 0 && errno == EINTR) continue;
+        if (k <= 0) return -1;
+        p += k; n -= (size_t)k;
+    }
+    return 0;
+}
+
+// ---------- the names the import has taken ----------
+// Every path under the save root, folded the way the save's own folder would fold it. Plain C has the C locale's fold (ASCII); the Mac's default folder folds all of
+// Unicode as well, and each staged entry's open(O_EXCL)/mkdir catches that one where the folder makes it — whichever catches it, nothing is ever silently overwritten.
+typedef struct { char **name; unsigned char *dir; size_t n, cap; size_t *slot; size_t slots; } names;
+
+static unsigned char fold_char(unsigned char c) { return c >= 'A' && c <= 'Z' ? (unsigned char)(c + 32) : c; }
+static uint64_t name_hash(const char *s) {
+    uint64_t h = 14695981039346656037ull;
+    for (; *s; s++) { h ^= fold_char((unsigned char)*s); h *= 1099511628211ull; }
+    return h;
+}
+static int same_name(const char *a, const char *b) {
+    for (; *a && *b; a++, b++) if (fold_char((unsigned char)*a) != fold_char((unsigned char)*b)) return 0;
+    return *a == *b;
+}
+static int name_at(names *k, const char *name) {
+    if (!k->slots) return -1;
+    for (size_t i = name_hash(name) & (k->slots - 1); k->slot[i] != SIZE_MAX; i = (i + 1) & (k->slots - 1))
+        if (same_name(k->name[k->slot[i]], name)) return (int)k->slot[i];
+    return -1;
+}
+static int name_put(names *k, const char *folded, int dir) {
+    if (k->n >= import_max_entries) { errno = EFBIG; return -1; }   // implicit ZIP parents count towards expanded entries too
