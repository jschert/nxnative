+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &wide) != 0 && errno == EFBIG && empty_dir(into) == 1, "one record whose name stands for six paths is refused at max_paths 4");
+    snprintf(bundle, sizeof bundle, "%s/many.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    bb_entry(&b, 1, "save/.dm-case-1", "\\u\\a\\b\\c", 8, "1", 1);
+    bb_entry(&b, 1, "save/.dm-case-2", "\\v\\a\\b\\c", 8, "2", 1);
+    bb_entry(&b, 1, "save/.dm-case-3", "\\w\\a\\b\\c", 8, "3", 1);
+    bb_close(&b, 0);
+    ss_limits eight = {100, 8, 64};
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &eight) != 0 && errno == EFBIG, "three records standing for twelve folders are refused at max_paths 8");
+    TRY(file_is(into, "save/.dm-case-1", "1") && file_is(into, "save/.dm-case-2", "2") && !file_is(into, "save/.dm-case-3", "3"), "the first two stand (eight paths), the third is refused before it is created");
+    // An ordinary child inherits its parent's legacy expansion even without metadata of its own.
+    snprintf(bundle, sizeof bundle, "%s/plain-child.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    bb_entry(&b, 0, "save/.dm-case-1", "\\a\\b\\c\\d", 8, "", 0);
+    bb_entry(&b, 1, "save/.dm-case-1/progress", "", 0, "x", 1);
+    bb_close(&b, 0);
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &four) != 0 && errno == EFBIG && !file_is(into, "save/.dm-case-1/progress", "x"), "an ordinary child cannot exceed the depth bound through its parent's legacy name");
+
+    // nested aliases: the depth that counts is the one after migration
+    snprintf(bundle, sizeof bundle, "%s/nest-ok.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    bb_entry(&b, 0, "save/.dm-case-1", "\\a\\b", 4, "", 0);
+    bb_entry(&b, 1, "save/.dm-case-1/.dm-case-2", "\\c\\d", 4, "n", 1);
+    bb_close(&b, 0);
+    TRY(ss_read_limited(bundle, INTO, &m, &four) == 0 && file_is(into, "save/.dm-case-1/.dm-case-2", "n"), "aliases nested to effective depth 4 read at max_depth 4 (physical depth 2)");
+    snprintf(bundle, sizeof bundle, "%s/nest-deep.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    bb_entry(&b, 0, "save/.dm-case-1", "\\a\\b", 4, "", 0);
+    bb_entry(&b, 1, "save/.dm-case-1/.dm-case-2", "\\c\\d\\e", 6, "n", 1);
+    bb_close(&b, 0);
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &four) != 0 && errno == EFBIG && dir_is(into, "save/.dm-case-1") && !file_is(into, "save/.dm-case-1/.dm-case-2", "n"), "a leaf whose effective depth (5) passes the bound is refused before it is created");
+
+    // a late record that deepens an existing directory is checked against everything below it
+    snprintf(bundle, sizeof bundle, "%s/late.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    bb_entry(&b, 1, "save/p/.dm-case-1/y", "", 0, "y", 1);           // .dm-case-1 implicit, extra 0
+    bb_entry(&b, 0, "save/p/.dm-case-1", "\\a\\b\\c\\d", 8, "", 0);   // its own record: extra 3, the child rides along
+    bb_close(&b, 0);
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &four) != 0 && errno == EFBIG && file_is(into, "save/p/.dm-case-1/y", "y"), "a late extra that would deepen the child past the bound is refused (the child stays where it was)");
+    snprintf(bundle, sizeof bundle, "%s/late-ok.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    bb_entry(&b, 1, "save/p/.dm-case-1/y", "", 0, "y", 1);
+    bb_entry(&b, 0, "save/p/.dm-case-1", "\\a\\b", 4, "", 0);
+    bb_close(&b, 0);
+    TRY(ss_read_limited(bundle, INTO, &m, &four) == 0 && file_is(into, "save/p/.dm-case-1/y", "y"), "a late extra that keeps everything within the bound reads (the child rides to depth 4)");
