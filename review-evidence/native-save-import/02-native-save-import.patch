+        unsigned char *d = realloc(k->dir, cap * sizeof *d); if (!d) return -1; k->dir = d;
+        k->cap = cap;
+    }
+    if (k->n + 1 > k->slots / 2) {   // half full at most, so the probe above stays short
+        size_t slots = k->slots ? k->slots * 2 : 128;
+        free(k->slot);
+        k->slot = malloc(slots * sizeof *k->slot); if (!k->slot) { k->slots = 0; return -1; }
+        k->slots = slots;
+        for (size_t i = 0; i < slots; i++) k->slot[i] = SIZE_MAX;
+        for (size_t i = 0; i < k->n; i++) {
+            size_t j;
+            for (j = name_hash(k->name[i]) & (k->slots - 1); k->slot[j] != SIZE_MAX; j = (j + 1) & (k->slots - 1));
+            k->slot[j] = i;
+        }
+    }
+    k->name[k->n] = strdup(folded); if (!k->name[k->n]) return -1;
+    k->dir[k->n] = (unsigned char)dir;
+    size_t j;
+    for (j = name_hash(folded) & (k->slots - 1); k->slot[j] != SIZE_MAX; j = (j + 1) & (k->slots - 1));
+    k->slot[j] = k->n++;
+    return 0;
+}
+static void names_free(names *k) {
+    for (size_t i = 0; i < k->n; i++) free(k->name[i]);
+    free(k->name); free(k->dir); free(k->slot);
+    memset(k, 0, sizeof *k);
+}
+static int make_dir(const char *save, const char *rel) {
+    char p[PATH_MAX];
+    if (join(p, sizeof p, save, rel)) return -1;
+    return mkdir(p, 0755);   // a new spelling that aliases an existing directory is a collision, not a merge
+}
+// Remember original spelling, not just the folded key. 0 = file, 1 = implicit parent, 2 = explicitly named directory.
+static int name_take(names *k, const char *rel, int dir, const char *save) {
+    char p[PATH_MAX]; size_t n = strlen(rel); unsigned depth = 1;
+    if (!n || n >= sizeof p) { errno = ENAMETOOLONG; return -1; }
+    for (const char *s = rel; *s; s++) if (*s == '/' && ++depth > IMPORT_MAX_DEPTH) { errno = ENAMETOOLONG; return -1; }
+    memcpy(p, rel, n + 1);
+    for (char *s = p; *s; s++) if (*s == '/') {
+        *s = 0;
+        int hit = name_at(k, p);
+        if (hit >= 0) {
+            if (!k->dir[hit] || strcmp(k->name[hit], p)) { errno = EEXIST; return -1; }
+        } else if (name_put(k, p, 1) || make_dir(save, p)) return -1;
+        *s = '/';
+    }
+    int hit = name_at(k, rel);
+    if (hit >= 0) {
+        if (dir && k->dir[hit] == 1 && !strcmp(k->name[hit], rel)) { k->dir[hit] = 2; return 0; }
+        errno = EEXIST; return -1;
+    }
+    if (name_put(k, rel, dir ? 2 : 0)) return -1;
+    return dir ? make_dir(save, rel) : 0;
+}
+
+// ---------- the staged save ----------
+typedef struct {
+    char save[PATH_MAX];   // <staging>/save: the imported save root, packed exactly as it stands
+    names took;
+    uint64_t bytes, entries;   // what has actually been streamed so far
+    int legacy_names;          // names whose backslashes may expand into folders when the save is next mounted
+    char *buf;                 // the one 64-KiB step everything moves in
+} importer;
+
+static int count_entry(importer *k) {
+    if (++k->entries > import_max_entries) { errno = EFBIG; return -1; }
+    return 0;
+}
+static int count_bytes(importer *k, uint64_t n) {
+    if (n > import_max_bytes - k->bytes) { errno = EFBIG; return -1; }   // k->bytes never passes the bound, so this cannot underflow
+    k->bytes += n;
+    return 0;
+}
+static int stage_open(importer *k, const char *rel, char *p) {   // the file <save>/<rel>, made alone: whatever is already there fails rather than being overwritten
+    if (join(p, PATH_MAX, k->save, rel)) return -1;
+    return open(p, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0644);
+}
+static int bring_guest_name(importer *k, int from, const char *to) {
+    char v[1024]; ssize_t n = fgetxattr(from, GUEST_NAME, v, sizeof v, 0, 0);
+    if (n >= 0) {
+        if (!ss_guest_name_valid(v, (size_t)n)) { errno = EINVAL; return -1; }
+        if (memchr(v, '\\', (size_t)n)) k->legacy_names = 1;
+        return n && setxattr(to, GUEST_NAME, v, (size_t)n, 0, XATTR_NOFOLLOW) ? -1 : 0;
+    }
+    return errno == ENOATTR || errno == ENOTSUP || errno == EINVAL ? 0 : -1;
+}
+static int pump_fd(importer *k, int in, int out, uint64_t *moved) {
+    for (;;) {
+        ssize_t got = read(in, k->buf, CHUNK);
+        if (got < 0) { if (errno == EINTR) continue; return -1; }
+        if (!got) return 0;
+        if (count_bytes(k, (uint64_t)got) || write_all(out, k->buf, (size_t)got)) return -1;
+        *moved += (uint64_t)got;
+    }
+}
+static int pump_zip(importer *k, struct archive *a, int out) {   // entry data only as it comes out of the archive: a header's size is never believed
+    for (;;) {
+        ssize_t got = archive_read_data(a, k->buf, CHUNK);
+        if (!got) return 0;
+        if (got < 0) { ILOG("zip: %s", archive_error_string(a) ? archive_error_string(a) : "read failed"); errno = EIO; return -1; }
+        if (count_bytes(k, (uint64_t)got) || (out >= 0 && write_all(out, k->buf, (size_t)got))) return -1;
+    }
+}
+
+// ---------- a folder, or one file ----------
+static int stable(const struct stat *a, const struct stat *b) {
+    return a->st_dev == b->st_dev && a->st_ino == b->st_ino && a->st_mode == b->st_mode && a->st_size == b->st_size
+        && a->st_mtimespec.tv_sec == b->st_mtimespec.tv_sec && a->st_mtimespec.tv_nsec == b->st_mtimespec.tv_nsec
+        && a->st_ctimespec.tv_sec == b->st_ctimespec.tv_sec && a->st_ctimespec.tv_nsec == b->st_ctimespec.tv_nsec;
+}
+static int take_dir(importer *k, int in, const char *rel, const struct stat *before);
+static int take_file(importer *k, int in, const char *rel, const struct stat *before) {
+    char p[PATH_MAX];
+    if (!k->legacy_names && strchr(rel, '\\')) k->legacy_names = 1;
+    if (before->st_size < 0 || (uint64_t)before->st_size > import_max_bytes - k->bytes) { errno = EFBIG; return -1; }
+    if (count_entry(k) || name_take(&k->took, rel, 0, k->save)) return -1;
+    int out = stage_open(k, rel, p); if (out < 0) return -1;
+    int r = -1; uint64_t moved = 0; struct stat after;
+    if (!pump_fd(k, in, out, &moved) && !bring_guest_name(k, in, p) && !fstat(in, &after)) {
+        if (!stable(before, &after) || moved != (uint64_t)before->st_size) errno = ESTALE;
+        else r = 0;   // packed as of the import: a raw input carries the date it was imported, not its export's age
+    }
+    int e = errno;
+    if (close(out) && !r) { r = -1; e = errno; }
+    if (r) unlink(p);
+    errno = e;
+    return r;
+}
+static int import_dir(importer *k, int in, const char *rel, const struct stat *before) {
+    int copy = fcntl(in, F_DUPFD_CLOEXEC, 0); if (copy < 0) return -1;
+    DIR *d = fdopendir(copy); if (!d) { int e = errno; close(copy); errno = e; return -1; }
+    struct dirent *entry; int r = 0;
+    for (;;) {
+        errno = 0; entry = readdir(d);
+        if (!entry) { if (errno) r = -1; break; }
+        if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..") || !strcmp(entry->d_name, ".DS_Store")) continue;
+        char p[PATH_MAX]; struct stat expected, opened;
+        if (join_rel(p, sizeof p, rel, entry->d_name) || fstatat(in, entry->d_name, &expected, AT_SYMLINK_NOFOLLOW)) { r = -1; break; }
+        if (!S_ISDIR(expected.st_mode) && !S_ISREG(expected.st_mode)) { errno = EPERM; r = -1; break; }
+        int child = openat(in, entry->d_name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+        if (child < 0) { r = -1; break; }
+        if (fstat(child, &opened)) r = -1;
+        else if (!stable(&expected, &opened)) { errno = ESTALE; r = -1; }
+        else r = S_ISDIR(opened.st_mode) ? take_dir(k, child, p, &opened) : take_file(k, child, p, &opened);
+        int e = errno; close(child); errno = e;
+        if (r) break;
+    }
+    struct stat after;
+    if (!r && fstat(in, &after)) r = -1;
+    else if (!r && !stable(before, &after)) { errno = ESTALE; r = -1; }
+    int e = errno; if (closedir(d) && !r) r = -1, e = errno;
+    errno = e;
+    return r;
+}
+static int take_dir(importer *k, int in, const char *rel, const struct stat *before) {
+    char p[PATH_MAX];
+    if (!k->legacy_names && strchr(rel, '\\')) k->legacy_names = 1;
+    if (count_entry(k) || name_take(&k->took, rel, 1, k->save) || join(p, sizeof p, k->save, rel) || bring_guest_name(k, in, p)) return -1;
+    return import_dir(k, in, rel, before);
+}
+
+// ---------- a ZIP ----------
+// Libarchive canonicalizes Windows separators. Validate that decoded path before creating anything: it must remain relative and confined.
+static int parts_ok(const char *p) {   // every part of a relative path names something: none is empty, . or ..
+    for (const char *s = p;; ) {
+        const char *e = strchr(s, '/'); size_t n = e ? (size_t)(e - s) : strlen(s);
+        if (!n || (n == 1 && s[0] == '.') || (n == 2 && s[0] == '.' && s[1] == '.')) return 0;
+        if (!e) return 1;
+        s = e + 1;
+    }
+}
+static int zip_path_ok(const char *p) {
+    if (!*p || *p == '/' || strchr(p, '\\')) return 0;
+    if (((p[0] >= 'A' && p[0] <= 'Z') || (p[0] >= 'a' && p[0] <= 'z')) && p[1] == ':') return 0;
+    return parts_ok(p);
+}
+static int import_zip(importer *k, int in) {
+    struct archive *a = archive_read_new();
+    if (!a) { errno = ENOMEM; return -1; }
+    int r = -1;
+    if (archive_read_support_format_zip(a) != ARCHIVE_OK) { errno = EIO; goto done; }
+    // Save imports discard Finder metadata themselves. Disable eager AppleDouble expansion so it cannot bypass our streaming limits.
+    if (archive_read_set_format_option(a, "zip", "mac-ext", NULL) != ARCHIVE_OK) { errno = EIO; goto done; }
+    if (archive_read_open_fd(a, in, CHUNK)) { ILOG("zip: %s", archive_error_string(a) ? archive_error_string(a) : "open failed"); errno = EIO; goto done; }
+    for (;;) {
+        struct archive_entry *e;
+        int step = archive_read_next_header(a, &e);
+        if (step == ARCHIVE_EOF) break;
+        if (step != ARCHIVE_OK) { ILOG("zip: %s", archive_error_string(a) ? archive_error_string(a) : "read failed"); errno = EIO; goto done; }
+        const char *raw = archive_entry_pathname_utf8(e);
+        mode_t t = archive_entry_filetype(e);
+        if ((t != AE_IFDIR && t != AE_IFREG) || archive_entry_hardlink(e) || archive_entry_symlink(e)) { errno = EPERM; goto done; }   // a link, a hardlink, a device, a fifo: not a save's content
+        if (count_entry(k)) goto done;   // ignored metadata and root entries also consume the input budget
+        char rel[PATH_MAX]; size_t n;
+        if (!raw) { errno = EPERM; goto done; }
+        n = strlen(raw); while (n && raw[n - 1] == '/') n--;   // the folder mark: what the entry names is the part before it
+        if (!n || n >= sizeof rel) { errno = n ? ENAMETOOLONG : EPERM; goto done; }   // only folder marks: nothing is named
+        memcpy(rel, raw, n); rel[n] = 0;
+        while (rel[0] == '.' && rel[1] == '/') memmove(rel, rel + 2, strlen(rel + 2) + 1);   // the harmless ./ zip tools write before every name: the entry's own name is what follows it
+        if (!rel[0] || !strcmp(rel, ".")) {
+            if (t != AE_IFDIR) { errno = EPERM; goto done; }
+            if (pump_zip(k, a, -1)) goto done;
+            continue;
+        }
+        if (!zip_path_ok(rel)) { errno = EPERM; goto done; }
+        const char *base = strrchr(rel, '/'); base = base ? base + 1 : rel;
+        if (!strcmp(base, ".DS_Store") || (!strncmp(rel, "__MACOSX", 8) && (!rel[8] || rel[8] == '/'))) {   // Finder's packaging, not the save's
+            if (pump_zip(k, a, -1)) goto done;
+            continue;
+        }
+        if (t == AE_IFDIR) {
+            if (name_take(&k->took, rel, 1, k->save) || pump_zip(k, a, -1)) goto done;
+        } else {
+            char p[PATH_MAX];
+            if (name_take(&k->took, rel, 0, k->save)) goto done;
+            int out = stage_open(k, rel, p); if (out < 0) goto done;
+            int bad = pump_zip(k, a, out);
+            int e2 = errno;
+            if (close(out) && !bad) bad = -1, e2 = errno;
+            errno = e2;
+            if (bad) { unlink(p); goto done; }
+        }
+    }
+    r = 0;
+done:;
+    int e = errno; archive_read_free(a); errno = e;
+    return r;
+}
+
+// ---------- a .dmsync ----------
+static int import_dmsync(const char *title, int in, const struct stat *before, const char *stage, const char *partial) {
+    if (before->st_size < 0 || (uint64_t)before->st_size > import_max_archive_bytes) { errno = EFBIG; return -1; }
+    int out = open(partial, O_WRONLY | O_TRUNC | O_CLOEXEC | O_NOFOLLOW); if (out < 0) return -1;
+    char buf[CHUNK]; uint64_t moved = 0; int r = -1;
+    for (;;) {
+        ssize_t got = read(in, buf, sizeof buf);
+        if (got < 0) { if (errno == EINTR) continue; break; }
+        if (!got) { r = 0; break; }
+        if ((uint64_t)got > import_max_archive_bytes - moved) { errno = EFBIG; break; }
+        if (write_all(out, buf, (size_t)got)) break;
+        moved += (uint64_t)got;
+    }
+    struct stat after;
+    if (!r && fstat(in, &after)) r = -1;
+    else if (!r && (!stable(before, &after) || moved != (uint64_t)before->st_size)) { errno = ESTALE; r = -1; }
+    if (!r && fsync(out)) r = -1;
+    int e = errno; if (close(out) && !r) r = -1, e = errno;
+    if (r) { errno = e; return -1; }
+    // Validate the immutable copy, not a source that could change after it was checked.
+    char check[PATH_MAX], save[PATH_MAX]; ss_meta expected, actual;
+    ss_limits limits = {import_max_bytes, import_max_entries, IMPORT_MAX_DEPTH};
+    if (ss_read_limited(partial, NULL, &expected, &limits)) return -1;
+    if (!expected.files || strcasecmp(expected.title, title)) { errno = EINVAL; return -1; }
+    if (join(check, sizeof check, stage, "check") || ss_read_limited(partial, check, &expected, &limits)) return -1;
+    if (join(save, sizeof save, check, "save") || ss_scan(save, &actual)) return -1;
+    if (strcmp(expected.hash, actual.hash)) { errno = EINVAL; return -1; }   // no duplicate directories or filesystem-folded merges
+    return 0;
+}
+
+// ---------- the picked root ----------
+// The picker's answer, judged like any other untrusted input: a relative directory the staged save really holds — never an absolute path, an empty, . or ..
+// part, or a file (the staging holds no links at all: neither a folder nor a ZIP import stages one, so what lstat sees there is real). "" reroots nothing; a
+// pick with no file in it fails at the packing, as an empty import does. Anything else becomes <staging>/save itself, by rename alone — no staged byte is
+// copied, read or decompressed a second time — and the export's other levels and siblings are dropped with the rest of the tree, so ss_pack (which packs
+// <save> and <save>_device) cannot take a sibling named like the pick plus _device for the device save.
+static int pick_root_apply(const char *held, const char *stage, char *sel) {
+    if (sel[0] == '/') { errno = EINVAL; return -1; }
+    size_t n = strlen(sel);
+    if (!n) return 0;   // the entire export, exactly as staged
+    while (n && sel[n - 1] == '/') sel[--n] = 0;   // the folder mark, as paths are trimmed at the save root itself
+    if (!n) { errno = EINVAL; return -1; }   // folder marks alone name nothing
+    if (!parts_ok(sel)) { errno = EINVAL; return -1; }
+    char from[PATH_MAX], via[PATH_MAX]; struct stat st;
+    if (join(from, sizeof from, held, sel) || lstat(from, &st)) return -1;   // names nothing the staging holds
+    if (!S_ISDIR(st.st_mode)) { errno = ENOTDIR; return -1; }
+    if (join(via, sizeof via, stage, "picked") || rename(from, via)) return -1;
+    return rmrf(held) || rename(via, held) ? -1 : 0;   // the pick is packed at the canonical staging/save path; the wrapper and its siblings go
+}
+
+// Selected-root JKSV metadata: 86 bytes, revision at 4, little-endian title at 5, save type at 37.
+// Ordinary same-named payload stays; recognized records must be this game's account save before they are omitted.
+static int jksv_root_meta(const char *held, const char *title) {
+    char p[PATH_MAX]; struct stat st;
+    if (join(p, sizeof p, held, ".nx_save_meta.bin") || lstat(p, &st)) return errno == ENOENT ? 0 : -1;
+    if (!S_ISREG(st.st_mode)) return 0;   // a same-named directory: payload, like any other
+    unsigned char b[87]; size_t got = 0;   // the 86-byte record, and one byte more to tell a longer one from it
+    int fd = open(p, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) return -1;
+    while (got < sizeof b) {
+        ssize_t n = read(fd, b + got, sizeof b - got);
+        if (n > 0) got += (size_t)n;
+        else if (!n) break;
+        else if (errno != EINTR) { int e = errno; close(fd); errno = e; return -1; }
+    }
+    if (close(fd)) return -1;
+    if (got < 4 || memcmp(b, "JKSV", 4)) return 0;   // not JKSV's: an ordinary file under the same name
+    if (got != 86 || b[4] != 1) { ILOG("jksv metadata: %zu bytes, revision %d: not the revision-1 record", got, got > 4 ? b[4] : 0); errno = ENOTSUP; return -1; }
+    uint64_t app = 0;
+    for (int i = 0; i < 8; i++) app |= (uint64_t)b[5 + i] << (8 * i);
+    if (app != strtoull(title, NULL, 16)) { ILOG("jksv metadata names %016llX, not %s", (unsigned long long)app, title); errno = EINVAL; return -1; }
+    if (b[37] != 1) { ILOG("jksv metadata: save type %d is not an account save", b[37]); errno = ENOTSUP; return -1; }
+    return unlink(p);   // recognized, and this game's account save: excluded from what is packed
+}
+
+// ---------- the import itself ----------
+int mac_save_import(const char *save, const char *title, const char *source, const char *archive, mac_save_scope *scope, mac_save_root_picker pick_root, void *context) {
+    char root[PATH_MAX], src[PATH_MAX], selected[PATH_MAX], adir[PATH_MAX], destination[PATH_MAX], stage[PATH_MAX], partial[PATH_MAX];
+    struct stat st, opened;
+    mac_save_scope what = MAC_SAVE_PRIMARY;
+    int r = -1, staged = 0, input = -1;
+    if (!save || !*save || !title || !*title || !source || !*source || !archive || !*archive || !scope) { errno = EINVAL; return -1; }
+    if (snprintf(selected, sizeof selected, "%s", source) >= (int)sizeof selected) { errno = ENAMETOOLONG; return -1; }
+    size_t sn = strlen(selected); while (sn > 1 && selected[sn - 1] == '/') selected[--sn] = 0;
+    if (mac_save_path(save, root) || lstat(selected, &st)) return -1;
+    if (!S_ISDIR(st.st_mode) && !S_ISREG(st.st_mode)) { errno = EPERM; return -1; }
+    if (!realpath(selected, src)) return -1;
+    // The archive's own folder, where the staging and the partial archive are made
+    char d[PATH_MAX]; const char *slash = strrchr(archive, '/');
+    if (slash) { size_t n = slash == archive ? 1 : (size_t)(slash - archive); if (n >= sizeof d) { errno = ENAMETOOLONG; return -1; } memcpy(d, archive, n); d[n] = 0; }
+    else strcpy(d, ".");
+    if (!realpath(d, adir)) return -1;
+    const char *leaf = slash ? slash + 1 : archive;
+    if (!*leaf || !strcmp(leaf, ".") || !strcmp(leaf, "..")) { errno = EINVAL; return -1; }
+    if (join(destination, sizeof destination, adir, leaf)) return -1;
+    // What a host run and its transaction put beside the save (hle_fs.c: the committed folder, the separate device save, and their .work and .new): the source is
+    // neither one of these nor holds them, and the archive is staged beside them, never inside — whatever is imported, the live save is not a byte of it.
+    static const char *const BESIDE[] = {"", "_device", ".work", "_device.work", ".new", "_device.new"};
+    for (int i = 0; i < (int)(sizeof BESIDE / sizeof *BESIDE); i++) {
+        char v[PATH_MAX];
+        if (snprintf(v, sizeof v, "%s%s", root, BESIDE[i]) >= (int)sizeof v) { errno = ENAMETOOLONG; return -1; }
+        if (under(src, v) || under(v, src) || under(adir, v)) { errno = EPERM; return -1; }
+    }
+    if (!strcmp(destination, src) || under(adir, src)) { errno = EPERM; return -1; }
+    enum { IMP_FOLDER, IMP_FILE, IMP_ZIP, IMP_DMSYNC } mode = S_ISDIR(st.st_mode) ? IMP_FOLDER : IMP_FILE;
+    // The file's name claims what it is — a .zip export, a .dmsync backup — and the claim is then checked: the container has to hold what its kind reads, and a
+    // malformed one never falls back to being taken as a plain save file. Every other file is one opaque save file under its own name, whatever its bytes start
+    // with: a save of the game's own may be a zip container itself, and only the name the player picked claims otherwise (a folder holds such a file as it is).
+    if (mode == IMP_FILE && ends_with_ci(source, ".dmsync")) mode = IMP_DMSYNC;
+    else if (mode == IMP_FILE && ends_with_ci(source, ".zip")) mode = IMP_ZIP;
+    if (snprintf(stage, sizeof stage, "%s/.import-XXXXXX", adir) >= (int)sizeof stage ||
+        snprintf(partial, sizeof partial, "%s.partial-XXXXXX", destination) >= (int)sizeof partial) { errno = ENAMETOOLONG; return -1; }
+    input = open(src, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK); if (input < 0) return -1;
+    if (fstat(input, &opened)) { int e = errno; close(input); errno = e; return -1; }
+    if (!stable(&st, &opened)) { close(input); errno = ESTALE; return -1; }
+    // Different case/Unicode spellings (or a hard link) can be the same entry: a string comparison must not let the final rename replace its own source.
+    struct stat output;
+    if (!stat(destination, &output) && output.st_dev == opened.st_dev && output.st_ino == opened.st_ino) { close(input); errno = EPERM; return -1; }
+    if (!mkdtemp(stage)) { int e = errno; close(input); errno = e; return -1; }
+    staged = 1;
+    int fd = mkstemp(partial);
+    if (fd < 0) goto done;
+    close(fd);
+    if (mode == IMP_DMSYNC) {
+        if (import_dmsync(title, input, &st, stage, partial)) goto done;
+        what = MAC_SAVE_ALL;
+    } else {
+        importer k; memset(&k, 0, sizeof k);
+        char held[PATH_MAX];
+        int bad = join(held, sizeof held, stage, "save") ? -1 : (mkdir(held, 0755) && errno != EEXIST ? -1 : 0);
+        if (!bad && !(k.buf = malloc(CHUNK))) bad = -1;
+        if (!bad) {
+            strlcpy(k.save, held, sizeof k.save);
+            if (mode == IMP_FOLDER) bad = import_dir(&k, input, "", &st);
+            else if (mode == IMP_ZIP) {
+                bad = import_zip(&k, input);
+                if (!bad && fstat(input, &opened)) bad = -1;
+                else if (!bad && !stable(&st, &opened)) { errno = ESTALE; bad = -1; }
+            }
+            else {
+                const char *base = strrchr(src, '/');
+                base = base ? base + 1 : src;
+                if (!strcmp(base, ".DS_Store")) { errno = ENODATA; bad = -1; }   // Finder's view of a folder, picked as one file: no save in it
+                else bad = take_file(&k, input, base, &st);
