+static int pick_save_root(const char *staged, char *selected, size_t selected_size, void *context) {
+    if (!staged || !*staged || !selected || !selected_size || !context) { errno = EINVAL; return -1; }
+    selected[0] = 0;
+    import_pick_ctx *ctx = context;
+    DmMacMenus *menus = ctx->menus;
+    NSString *source = ctx->source;
