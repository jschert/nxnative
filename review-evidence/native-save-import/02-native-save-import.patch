+    // what this host itself writes: an alias costs nothing, a single-name legacy name nothing, a nested one its folders
+    snprintf(bundle, sizeof bundle, "%s/legacy.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    bb_entry(&b, 1, "save/.dm-case-3", "Mixed", 5, "a", 1);
