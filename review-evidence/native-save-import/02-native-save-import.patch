+// Only the host's exact request markers are accepted; raw imports replace the primary save, not a newer device save.
+static int restore_scope(const char *ready, mac_save_scope *scope) {
+    FILE *f = fopen(ready, "rb"); if (!f) return -1;
+    char marker[sizeof MAC_SAVE_PRIMARY_REQUEST];
+    size_t n = fread(marker, 1, sizeof marker, f);
+    int failed = ferror(f); if (fclose(f)) failed = 1;
+    if (!failed && !n) { *scope = MAC_SAVE_ALL; return 0; }
+    if (!failed && n == sizeof MAC_SAVE_PRIMARY_REQUEST - 1 && !memcmp(marker, MAC_SAVE_PRIMARY_REQUEST, n)) {
+        *scope = MAC_SAVE_PRIMARY; return 0;
+    }
+    errno = EINVAL; return -1;
+}
+
+static int restore_format(const char *dir) {
+    char file[PATH_MAX];
+    if (snprintf(file, sizeof file, "%s/format", dir) >= (int)sizeof file) return 0;
+    FILE *f = fopen(file, "wb"); if (!f) return 0;
+    int ok = fwrite(MAC_SAVE_REQUEST_FORMAT, 1, sizeof MAC_SAVE_REQUEST_FORMAT - 1, f) == sizeof MAC_SAVE_REQUEST_FORMAT - 1;
+    if (fclose(f)) ok = 0;
+    return ok;
+}
