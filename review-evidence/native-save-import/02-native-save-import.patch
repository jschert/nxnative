+// ---- ss_read_limited: the bounds themselves, each refused before the entry that crosses it materializes ----
+static void check_read_bounds(void) {
+    char root[] = "/tmp/dm-save-sync-metadata-lim-XXXXXX", bundle[PATH_MAX], into[PATH_MAX];
+    if (!mkdtemp(root)) abort();
+    ss_limits lim = {100, 8, 4}, byt = {10, 64, 8};
+    ss_meta m;
+    bb b;
+    int nk = 0;
+#define INTO (snprintf(into, sizeof into, "%s/i%d", root, ++nk), mkdirs(into), into)
+
+    // depth below the save root: at the bound it reads, one component deeper nothing of the entry is created -- hash right or wrong
+    snprintf(bundle, sizeof bundle, "%s/deep-ok.dmsync", root);
+    bb_open(&b, bundle, "0100ABC"); bb_entry(&b, 1, "save/a/b/c/f", "", 0, "d", 1); bb_close(&b, 0);
+    TRY(ss_read_limited(bundle, INTO, &m, &lim) == 0 && file_is(into, "save/a/b/c/f", "d"), "depth at the bound reads, its implicit folders counting as paths (4)");
+    snprintf(bundle, sizeof bundle, "%s/deep.dmsync", root);
+    bb_open(&b, bundle, "0100ABC"); bb_entry(&b, 1, "save/a/b/c/d/f", "", 0, "d", 1); bb_close(&b, 0);
+    TRY(ss_read(bundle, INTO, &m) == 0 && file_is(into, "save/a/b/c/d/f", "d"), "the trusted reader keeps today's behavior: no depth bound");
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &lim) != 0 && errno == EFBIG && empty_dir(into) == 1, "one component deeper than the bound materializes nothing, not even the save root (EFBIG)");
+    TRY(ss_read_limited(bundle, NULL, &m, &lim) != 0, "the checking pass alone refuses it too");
+    bb_open(&b, bundle, "0100ABC"); bb_entry(&b, 1, "save/a/b/c/d/f", "", 0, "d", 1); bb_close(&b, 1);   // and a wrong hash besides
+    TRY(ss_read_limited(bundle, INTO, &m, &lim) != 0 && empty_dir(into) == 1, "a too-deep bundle with a wrong hash is refused before either the bound or the hash could pass");
+
+    // Two records expand to ten payload paths; allow their depth so this exercises path count, not the independent depth limit.
+    snprintf(bundle, sizeof bundle, "%s/amp.dmsync", root);
+    ss_limits amp = {100, 8, 5};
+    bb_open(&b, bundle, "0100ABC");
+    bb_entry(&b, 1, "save/p/a/b/c/f1", "", 0, "1", 1);
+    bb_entry(&b, 1, "save/q/a/b/c/f2", "", 0, "2", 1);
+    bb_close(&b, 0);
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &amp) != 0 && errno == EFBIG, "few records cannot spread more folders than the bound");
+    TRY(file_is(into, "save/p/a/b/c/f1", "1") && !dir_is(into, "save/q"), "the first record's folders stand, the second's are never made");
+
+    // paths at the bound: eight records read, the ninth is refused before it is created
+    snprintf(bundle, sizeof bundle, "%s/p8.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    for (int i = 1; i <= 8; i++) { char rel[16]; snprintf(rel, sizeof rel, "save/f%d", i); bb_entry(&b, 1, rel, "", 0, "x", 1); }
+    bb_close(&b, 0);
+    TRY(ss_read_limited(bundle, INTO, &m, &lim) == 0 && m.files == 8, "as many records as the bound allows read");
+    snprintf(bundle, sizeof bundle, "%s/p9.dmsync", root);
+    bb_open(&b, bundle, "0100ABC");
+    for (int i = 1; i <= 9; i++) { char rel[16]; snprintf(rel, sizeof rel, "save/f%d", i); bb_entry(&b, 1, rel, "", 0, "x", 1); }
+    bb_close(&b, 0);
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &lim) != 0 && errno == EFBIG && empty_dir(into) == 1, "more records declared than the bound: not one of them is read");
+    snprintf(bundle, sizeof bundle, "%s/px.dmsync", root);   // records at the bound, paths past it: the last entry's folders are never made
+    bb_open(&b, bundle, "0100ABC");
+    for (int i = 1; i <= 7; i++) { char rel[16]; snprintf(rel, sizeof rel, "save/f%d", i); bb_entry(&b, 1, rel, "", 0, "x", 1); }
+    bb_entry(&b, 1, "save/x/y/z/f", "", 0, "x", 1);
+    bb_close(&b, 0);
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &lim) != 0 && errno == EFBIG && file_is(into, "save/f7", "x") && !dir_is(into, "save/x"), "the entry whose folders pass the bound is refused before they are made");
+
+    // payload bytes: at the bound they read, past it the file is never created
+    snprintf(bundle, sizeof bundle, "%s/by2.dmsync", root);
+    bb_open(&b, bundle, "0100ABC"); bb_entry(&b, 1, "save/a", "", 0, "12345", 5); bb_entry(&b, 1, "save/b", "", 0, "67890", 5); bb_close(&b, 0);
+    TRY(ss_read_limited(bundle, INTO, &m, &byt) == 0 && m.files == 2, "payload bytes at the bound read");
+    snprintf(bundle, sizeof bundle, "%s/by3.dmsync", root);
+    bb_open(&b, bundle, "0100ABC"); bb_entry(&b, 1, "save/a", "", 0, "12345", 5); bb_entry(&b, 1, "save/b", "", 0, "67890", 5); bb_entry(&b, 1, "save/c", "", 0, "abcde", 5); bb_close(&b, 0);
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &byt) != 0 && errno == EFBIG && file_is(into, "save/b", "67890") && !file_is(into, "save/c", "abcde"), "the file past the byte bound is refused before it is created");
+    snprintf(bundle, sizeof bundle, "%s/by1.dmsync", root);
+    bb_open(&b, bundle, "0100ABC"); bb_entry(&b, 1, "save/big", "", 0, "0123456789A", 11); bb_close(&b, 0);
+    errno = 0;
+    TRY(ss_read_limited(bundle, INTO, &m, &byt) != 0 && errno == EFBIG && empty_dir(into) == 1, "a file that alone passes the byte bound is never created");
+
+    rm_tree(root);
+#undef INTO
+}
