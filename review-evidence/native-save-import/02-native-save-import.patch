+// ---- a packed save written entry by entry, for bundles ss_pack would never write ----
+typedef struct { FILE *f; CC_SHA256_CTX sha; uint32_t entries; char hash[SS_HASH + 1]; } bb;
+static void bb_open(bb *b, const char *path, const char *title) {
+    uint8_t hdr[HDR] = {0}; uint32_t version = 1;
+    b->f = fopen(path, "wb"); b->entries = 0; b->hash[0] = 0;
+    if (!b->f) abort();
+    memcpy(hdr, MAGIC, 8); memcpy(hdr + 8, &version, 4); memcpy(hdr + 56, title, strlen(title));
+    if (fwrite(hdr, 1, HDR, b->f) != HDR) abort();
+    CC_SHA256_Init(&b->sha);
+}
+static void bb_entry(bb *b, int file, const char *path, const char *guest, size_t gl, const char *data, size_t size) {
+    uint8_t h[ENT] = {0}; uint16_t pl = (uint16_t)strlen(path), g = (uint16_t)gl; uint64_t sz = size; int64_t mt = 1000;
+    h[0] = (uint8_t)(file ? 2 : 1);
+    memcpy(h + 2, &pl, 2); memcpy(h + 4, &g, 2); memcpy(h + 8, &sz, 8); memcpy(h + 16, &mt, 8);
+    CC_SHA256_Update(&b->sha, h, 16); CC_SHA256_Update(&b->sha, path, pl); CC_SHA256_Update(&b->sha, guest, gl);
+    CC_SHA256_Update(&b->sha, data, (CC_LONG)size);
+    if (fwrite(h, 1, ENT, b->f) != ENT || fwrite(path, 1, pl, b->f) != pl || fwrite(guest, 1, gl, b->f) != gl || fwrite(data, 1, size, b->f) != size) abort();
+    b->entries++;
+}
+static void bb_close(bb *b, int break_hash) {   // finishes the bundle with its true hash, or one byte of it flipped
+    uint8_t d[CC_SHA256_DIGEST_LENGTH];
+    if (fwrite(END, 1, sizeof END, b->f) != sizeof END) abort();
+    CC_SHA256_Final(d, &b->sha); hex(d, b->hash);
+    if (break_hash) b->hash[0] = b->hash[0] == '0' ? '1' : '0';
+    if (fseek(b->f, 12, SEEK_SET) || fwrite(&b->entries, 4, 1, b->f) != 1 || fseek(b->f, 16, SEEK_SET) || fwrite(b->hash, 1, SS_HASH, b->f) != SS_HASH || fclose(b->f)) abort();
+}
