+// An old launcher treats every request as a full restore. Never offer raw import without typed-request support.
+static NSString *import_request(void) {
+    const char *dir = getenv("DM_MAC_RESTORE_DIR"); if (!dir || !*dir) return nil;
+    char path[PATH_MAX], format[sizeof MAC_SAVE_REQUEST_FORMAT]; struct stat st;
+    if (snprintf(path, sizeof path, "%s/format", dir) >= (int)sizeof path) return nil;
+    int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK); if (fd < 0) return nil;
+    ssize_t n = !fstat(fd, &st) && S_ISREG(st.st_mode) ? read(fd, format, sizeof format) : -1;
+    close(fd);
+    return n == (ssize_t)(sizeof MAC_SAVE_REQUEST_FORMAT - 1) && !memcmp(format, MAC_SAVE_REQUEST_FORMAT, (size_t)n) ? @(dir) : nil;
+}
+static BOOL request_current(NSString *request) {
+    const char *dir = getenv("DM_MAC_RESTORE_DIR");
+    return request && dir && !strcmp(dir, request.fileSystemRepresentation);
+}
+
+
+static NSString *selected_save_root(NSString *staged, NSString *chosen) {
+    if (![staged hasPrefix:@"/"] || ![chosen hasPrefix:@"/"]) return nil;
+    if ([staged.pathComponents containsObject:@".."] || [chosen.pathComponents containsObject:@".."]) return nil;
+    NSString *base = staged.stringByResolvingSymlinksInPath;
+    NSString *pick = chosen.stringByResolvingSymlinksInPath;
+    if ([pick isEqualToString:base]) return @"";
+    NSString *prefix = [base hasSuffix:@"/"] ? base : [base stringByAppendingString:@"/"];
+    if (![pick hasPrefix:prefix]) return nil;
+    NSString *rel = [pick substringFromIndex:prefix.length];
+    return rel.length && ![rel hasPrefix:@"/"] && ![rel.pathComponents containsObject:@".."] ? rel : nil;
+}
+
+static NSString *primary_import_warning(NSString *source) {
+    return [NSString stringWithFormat:@"Importing from %@ replaces the entire primary save for %s (%s) rather than merging files. Any separate device save will be kept. Unsaved progress will be lost, and your current save will be kept in a recovery folder. Raw folders, .zip archives, and save files cannot be verified to match this game or version; import a complete folder or .zip archive for multi-file saves. Start the game again after the import finishes.", source, DM_GAME_NAME, DM_GAME_ID];
+}
