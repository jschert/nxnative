+// JKSV's .nx_save_meta.bin as its exporter writes it (SaveMetaData.hpp's packed record): the fields the import judges, zero elsewhere.
+static unsigned char jksv[86];
+static void jksv_make(unsigned revision, uint64_t app, unsigned type) {
+    memset(jksv, 0, sizeof jksv);
+    memcpy(jksv, "JKSV", 4);
+    jksv[4] = revision;
+    for (int i = 0; i < 8; i++) jksv[5 + i] = (unsigned char)(app >> (8 * i));
+    jksv[37] = type;
+}
+// A .dmsync of two one-byte files: sound in the reading (the header, the hash, the end) — but its two names are one, or two the save's own folder folds onto one
+// another, which only unpacking catches
+static void make_dmsync2(const char *path, const char *title, const char *p1, const char *p2) {
+    const char *paths[2] = {p1, p2};
+    CC_SHA256_CTX c; CC_SHA256_Init(&c);
+    for (int i = 0; i < 2; i++) {
+        uint8_t h[24] = {2}; uint16_t pl = (uint16_t)strlen(paths[i]); uint64_t sz = 1;
+        memcpy(h + 2, &pl, 2); memcpy(h + 8, &sz, 8);
+        CC_SHA256_Update(&c, h, 16); CC_SHA256_Update(&c, paths[i], pl); CC_SHA256_Update(&c, "1", 1);
+    }
+    uint8_t d[CC_SHA256_DIGEST_LENGTH]; CC_SHA256_Final(d, &c);
+    FILE *f = fopen(path, "wb"); assert(f);
+    uint8_t hdr[144] = {0}; uint32_t one = 1, two = 2;
+    memcpy(hdr, "DMSYNC1\n", 8); memcpy(hdr + 8, &one, 4); memcpy(hdr + 12, &two, 4);
+    char hex[33]; for (int i = 0; i < 16; i++) snprintf(hex + 2 * i, 3, "%02x", d[i]);
+    memcpy(hdr + 16, hex, 32);
+    memcpy(hdr + 56, title, strlen(title));
+    assert(fwrite(hdr, 1, 144, f) == 144);
+    for (int i = 0; i < 2; i++) {
+        uint8_t h[24] = {2}; uint16_t pl = (uint16_t)strlen(paths[i]); uint64_t sz = 1;
+        memcpy(h + 2, &pl, 2); memcpy(h + 8, &sz, 8);
+        assert(fwrite(h, 1, 24, f) == 24); assert(fwrite(paths[i], 1, pl, f) == pl); assert(fwrite("1", 1, 1, f) == 1);
+    }
+    assert(fwrite("DMSYNCE\n", 1, 8, f) == 8); assert(!fclose(f));
+}
