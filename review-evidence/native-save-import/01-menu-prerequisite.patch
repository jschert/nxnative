diff --git a/dm/host/tests/t_mac_backup.c b/dm/host/tests/t_mac_backup.c
new file mode 100644
index 00000000..2bac3161
--- /dev/null
+++ b/dm/host/tests/t_mac_backup.c
@@ -0,0 +1,53 @@
+// Manual backup round trips, wrong/damaged archives, and rollback on a failed second directory swap.
+#include <assert.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include <sys/xattr.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <removefile.h>
+static int swaps, fail_swap;
+static int swap_for_test(const char *a, const char *b, unsigned flags) {
+    if (++swaps == fail_swap) { errno = EIO; return -1; }
+    return renamex_np(a, b, flags);
+}
+#define renamex_np swap_for_test
+#include "../save_backup_mac.c"
+#undef renamex_np
+static void put(const char *p, const char *value) { FILE *f = fopen(p, "w"); assert(f); assert(fputs(value, f) >= 0); assert(!fclose(f)); }
+static void contents(const char *p, const char *value) { char b[128] = {0}; FILE *f = fopen(p, "r"); assert(f); assert(fread(b, 1, sizeof b - 1, f) == strlen(value)); assert(!fclose(f)); assert(!strcmp(b, value)); }
+int main(void) {
+    char dir[] = "/tmp/nxnative-backup-XXXXXX"; assert(mkdtemp(dir)); assert(!chdir(dir));
+    assert(!mkdir("save", 0700)); assert(!mkdir("save_device", 0700));
+    put("save/a", "old normal"); put("save_device/b", "old device");
+    assert(!setxattr("save/a", "org.d2rmobile.guest-name", "A", 1, 0, 0));
+    assert(!mac_save_export("save/", "010093801237C000", "backup.dmsync"));
+    ss_meta m; assert(!ss_read("backup.dmsync", NULL, &m)); assert(m.files == 2);
+    put("save/a", "new normal"); put("save_device/b", "new device"); put("save/extra", "remove me");
+    char kept[PATH_MAX];
+    assert(mac_save_restore("save", "another-game", "backup.dmsync", kept, sizeof kept));
+    contents("save/a", "new normal");
+    put("broken.dmsync", "DMSYNC1\ntruncated");
+    assert(mac_save_restore("save", "010093801237C000", "broken.dmsync", kept, sizeof kept));
+    contents("save/a", "new normal");
+    swaps = 0; fail_swap = 2;
+    assert(mac_save_restore("save", "010093801237C000", "backup.dmsync", kept, sizeof kept));
+    contents("save/a", "new normal"); contents("save_device/b", "new device"); contents("save/extra", "remove me");
+    assert(*kept); char p[PATH_MAX]; snprintf(p, sizeof p, "%s/save/a", kept); contents(p, "new normal");
+    fail_swap = 0;
+    assert(!mac_save_restore("save/", "010093801237C000", "backup.dmsync", kept, sizeof kept));
+    contents("save/a", "old normal"); contents("save_device/b", "old device"); assert(access("save/extra", F_OK));
+    char guest[8]; assert(getxattr("save/a", "org.d2rmobile.guest-name", guest, sizeof guest, 0, 0) == 1 && *guest == 'A');
+    snprintf(p, sizeof p, "%s/save/extra", kept); contents(p, "remove me");
+    assert(!mkdir("empty", 0700)); assert(mac_save_export("empty", "010093801237C000", "backup.dmsync"));
+    assert(!ss_read("backup.dmsync", NULL, &m) && m.files == 2);   // failed exports keep the previous archive
+    assert(!removefile("save_device", NULL, REMOVEFILE_RECURSIVE));
+    assert(!mac_save_export("save", "010093801237C000", "normal-only.dmsync"));
+    assert(!mkdir("save_device", 0700)); put("save_device/extra", "remove device");
+    assert(!mac_save_restore("save", "010093801237C000", "normal-only.dmsync", kept, sizeof kept));
+    assert(access("save_device/extra", F_OK));
+    assert(!chdir("/")); assert(!removefile(dir, NULL, REMOVEFILE_RECURSIVE));
+    puts("Mac save backups: round trip, metadata, recovery, failed-swap rollback, invalid archives, empty exports and device removal pass");
+    return 0;
+}
diff --git a/dm/host/tests/t_mac_menus.m b/dm/host/tests/t_mac_menus.m
new file mode 100644
index 00000000..10d30113
--- /dev/null
+++ b/dm/host/tests/t_mac_menus.m
@@ -0,0 +1,118 @@
+// Real AppKit actions, isolated preferences and a synthetic runtime settings page; no user data or audio device.
+// Verified here is the menus' own behavior: choice persistence and default removal, launch-override precedence,
+// capability gating and numeric bounds of the runtime settings, checked/disabled validation against live state,
+// and the mute/focus invariants. The output gain behind the volume slider is exercised by t_audio.
+#include <assert.h>
+#include "../menus_mac.m"
+static int test_mode = 1, test_muted;
+uint8_t *dm_fps_state;
+int dm_opmode(void) { return test_mode; }
+void dm_set_opmode(int m) { test_mode = m; }
+void dm_audio_mute(int on) { test_muted = on; }
+void dm_audio_volume(int percent) { (void)percent; }   // the gain itself is t_audio's; linked because the menus reference it
+void dm_gfx_shot_at(long frame, const char *p) { (void)frame; (void)p; }
+static NSMenuItem *choice(NSString *env, NSString *value) {
+    NSMenuItem *item = [NSMenuItem new]; item.representedObject = @{@"env": env, @"value": value}; return item;
+}
+static float state_at(size_t offset) { float n; memcpy(&n, dm_fps_state + offset, sizeof n); return n; }
+static NSString *saved(NSString *domain, NSString *env) {
+    NSString *key = [@"launcher." stringByAppendingString:env];
+    CFPropertyListRef value = CFPreferencesCopyAppValue((__bridge CFStringRef)key, (__bridge CFStringRef)domain);
+    NSString *s = value && CFGetTypeID(value) == CFStringGetTypeID() ? [(__bridge NSString *)value copy] : nil;
+    if (value) CFRelease(value); return s;
+}
+int main(void) {
+    @autoreleasepool {
+        [NSApplication sharedApplication];
+        NSWindow *w = [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, 800, 450) styleMask:NSWindowStyleMaskTitled backing:NSBackingStoreBuffered defer:NO];
+        NSMenu *bar = [NSMenu new];
+        mac_menus_install(w, bar);
+        DmMacMenus *m = [[bar itemWithTitle:@"File"].submenu itemWithTitle:@"Open Save Folder"].target;
+        assert(m);
+        m.domain = [@"org.nxnative.menu-test." stringByAppendingString:NSUUID.UUID.UUIDString];
+        m.settings = @{
+            @"DM_OPMODE": @{@"kind": @"choice", @"label": @"Console mode", @"default": @"1", @"options": @[@[@"1", @"Docked"], @[@"0", @"Handheld"]]},
+            @"DM_FPS_TARGET": @{@"kind": @"choice", @"label": @"Frame rate", @"default": @"60", @"options": @[@[@"30", @"30 fps"], @[@"60", @"60 fps"]]},
+            @"DM_RENDER_SCALE": @{@"kind": @"range", @"label": @"Render scale", @"default": @"1.0", @"min": @0.5, @"max": @1.0, @"step": @0.05}
+        };
+
+        // Console mode goes through dm_set_opmode and is saved as the app's choice; choosing the default removes the key again
+        [m chooseSetting:choice(@"DM_OPMODE", @"0")];
+        assert(test_mode == 0 && [saved(m.domain, @"DM_OPMODE") isEqual:@"0"]);
+        [m chooseSetting:choice(@"DM_OPMODE", @"1")];
+        assert(test_mode == 1 && !saved(m.domain, @"DM_OPMODE"));
+
+        // A variable the launch environment or an env file set is the launcher's, not the menu's to change
+        setenv("DM_ENV_LAUNCH_KEYS", "DM_LANG DM_OPMODE", 1);
+        [m chooseSetting:choice(@"DM_OPMODE", @"0")];
+        assert(test_mode == 1);
+        unsetenv("DM_ENV_LAUNCH_KEYS"); setenv("DM_ENV_FILE_KEYS", "DM_OPMODE", 1);
+        [m chooseSetting:choice(@"DM_OPMODE", @"0")];
+        assert(test_mode == 1);
+        unsetenv("DM_ENV_FILE_KEYS");
+        [m chooseSetting:choice(@"DM_OPMODE", @"0")];
+        setenv("DM_SAVED_CHOICES", "0", 1);
+        [m chooseSetting:choice(@"DM_OPMODE", @"1")];
+        assert(test_mode == 1 && [saved(m.domain, @"DM_OPMODE") isEqual:@"0"]);   // a session that ignores saved choices does not erase them
+        unsetenv("DM_SAVED_CHOICES");
+        [m chooseSetting:choice(@"DM_OPMODE", @"1")];
+
+        // Frame rate and render scale need the runtime capability (the frame step state page); without it nothing is offered
+        NSMenu *settings = [NSMenu new];
+        setting_menu(settings, @"DM_FPS_TARGET", m);
+        assert(settings.numberOfItems == 0);
+        _Alignas(8) uint8_t page[64] = {0}; dm_fps_state = page;
+        setting_menu(settings, @"DM_FPS_TARGET", m); setting_menu(settings, @"DM_RENDER_SCALE", m);
+        NSMenu *fps = [settings itemWithTitle:@"Frame Rate"].submenu, *scale = [settings itemWithTitle:@"Render Scale"].submenu;
+        NSMenuItem *fps30 = [fps itemWithTitle:@"30 fps"], *fps60 = [fps itemWithTitle:@"60 fps"], *scale85 = [scale itemWithTitle:@"85%"];
+        assert(fps30 && fps60 && scale85);
+
+        // The checked mark follows the live state (not the saved choice), and each choice lands on its own state page word
+        [m chooseSetting:fps30];
+        assert(state_at(0) == 30 && [saved(m.domain, @"DM_FPS_TARGET") isEqual:@"30"]);
+        assert([m validateMenuItem:fps30] && fps30.state == NSControlStateValueOn);
+        assert([m validateMenuItem:fps60] && fps60.state == NSControlStateValueOff);
+        [m chooseSetting:fps60];
+        assert(state_at(0) == 60 && !saved(m.domain, @"DM_FPS_TARGET"));
+        [m chooseSetting:scale85];
+        assert(fabs(state_at(0x10) - 0.85) < 1e-6);
+
+        // Values outside the declared options and bounds never reach the state page
+        [m chooseSetting:choice(@"DM_FPS_TARGET", @"0")];
+        assert(state_at(0) == 60);
+        [m chooseSetting:choice(@"DM_RENDER_SCALE", @"1.00")];
+        assert(state_at(0x10) == 1 && !saved(m.domain, @"DM_RENDER_SCALE"));
+        [m chooseSetting:choice(@"DM_RENDER_SCALE", @"2")];
+        assert(state_at(0x10) == 1);
+
+        // A launch override disables the runtime setting's row as well
+        setenv("DM_ENV_FILE_KEYS", "DM_RENDER_SCALE", 1);
+        [m chooseSetting:scale85];
+        assert(state_at(0x10) == 1 && ![m validateMenuItem:scale85]);
+        unsetenv("DM_ENV_FILE_KEYS");
+
+        // A manual mute holds whatever the focus does; "mute when unfocused" follows the window, and only then
+        mac_menus_focus(1); [m mute:nil];
+        assert(test_muted);
+        mac_menus_focus(0); mac_menus_focus(1);
+        assert(test_muted);
+        [m mute:nil]; [m muteUnfocused:nil];
+        assert(!test_muted);
+        mac_menus_focus(0);
+        assert(test_muted);
+        mac_menus_focus(1);
+        assert(!test_muted);
+
+        // The restore transaction is offered only while the launcher has prepared its restore directory
+        NSMenuItem *restore = [[bar itemWithTitle:@"File"].submenu itemWithTitle:@"Restore Save from Backup…"];
+        setenv("DM_SAVE", "/", 1); setenv("DM_MAC_RESTORE_DIR", "/tmp/nxnative-menu-test-restore", 1);
+        assert([m validateMenuItem:restore]);
+        unsetenv("DM_MAC_RESTORE_DIR");
+        assert(![m validateMenuItem:restore]);
+        unsetenv("DM_SAVE");
+
+        [w close];
+        puts("Mac menus: choice persistence and default removal, launch overrides, capability gating, bounds, live checked state and mute/focus invariants pass");
+    }
+    return 0;
+}
